    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PinkMachine19.TimeClock.Web</RootNamespace>
    <AssemblyName>PinkMachine19.TimeClock.Web</AssemblyName>
